# SAMDEENIYOM bowl server settings — copy to .env and edit (never commit or share it)
PORT=8787
# keep 127.0.0.1 when a tunnel / proxy runs on the same machine
HOST=127.0.0.1
SHOP_NAME=SAMDEENIYOM
ORDERS_DIR=~/samdeeniyom-orders
# password for /admin (user: admin). Use a long random one.
ADMIN_PASS=change-me
# the shop's build plate in mm: a square plate "256" or a rectangular one "330x320". Sizes that do not fit are closed for ordering.
# (old values a1mini / a1 / sparkx_i7 / current / a2l of SDN_PRINTER are still understood as plate sizes)
SDN_BED=256
# 1 = customers may also download the print files themselves (free). 0 = only the shop gets the files (made-to-order shop).
SDN_FREE_DOWNLOAD=0
# link back to the main website shown in the header (optional)
HOME_URL=
# behind a tunnel / reverse proxy on this machine: 1, and name the header that holds the visitor's address (Cloudflare: cf-connecting-ip).
# Without this every visitor looks like 127.0.0.1 and the order / lock-out limits would apply to everybody at once.
TRUST_PROXY=0
IP_HEADER=
# optional notifications (fill any)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
LINE_CHANNEL_TOKEN=
LINE_TO=
